# Usage:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your Auth0 values before running the DPoP client.

# Your Auth0 tenant domain (without https://)
AUTH0_DOMAIN=okta-auth0 domain url here

# API identifier from Auth0 dashboard
AUTH0_AUDIENCE=Your okta-auth0 API identifier here

# Machine-to-Machine application credentials
AUTH0_CLIENT_ID=okta-auth0 client id here
AUTH0_CLIENT_SECRET=okta-auth0 client secret here
# API base URL (default: playground server)
API_BASE_URL=https://localhost:7168