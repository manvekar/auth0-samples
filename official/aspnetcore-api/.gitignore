# Ignoring build output
bin/
obj/

# Ignoring generated documentation XML files
src/**/*.xml

# Ignoring user-specific files
*.user
*.sln.DotSettings.user

# Ignoring publish output
publish/
out/

# Ignoring VS Code settings
.vscode/

# Ignoring Rider settings
.idea/

# Ignoring NuGet packages
*.nupkg

# Ignoring logs
*.log

# Ignoring test results
TestResults/
*.trx
*.coverage
*.coveragexml

# Ignoring local secrets
secrets.json
.github/copilot-instructions.md

# Ignoring integration test configuration (contains Auth0 credentials)
tests/Auth0.AspNetCore.Authentication.Api.IntegrationTests/client-secrets.json

# Ignoring DocFX output
_site/
docs/
docs-source/api/
.docfx/
docfx.zip

# Ignoring Misc
.DS_Store
.github/.DS_Store

# ============================================
# ADDITIONAL SECRET & SENSITIVE FILES
# ============================================

# Environment files (all variants)
.env*
!.env.example

# Secrets directories
secrets/
secret/
.credentials/

# Private keys
*.pem
*.p8
*.key
*.crt
*.p12
*.pfx

# Secrets by extension
*.secret
*.credentials

# Development configs with secrets
appsettings.*.json
!appsettings.example.json
!appsettings.template.json

# Auth0 specific
*.auth0
auth0-config.json
auth0-credentials.json

# Test credentials
test-data.json
test-credentials.json
integration-test-secrets.json
